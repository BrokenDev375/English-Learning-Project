  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "Metric": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "correct",
          "incorrect",
          "unanswered",
          "accuracyPercent"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "correct": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "incorrect": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "unanswered": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "accuracyPercent": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Performance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "first",
          "guided",
          "assisted",
          "independentNew",
          "independentSeen",
          "guidedRetries",
          "corrections"
        ],
        "properties": {
          "first": {
            "$ref": "#/components/schemas/Metric"
          },
          "guided": {
            "$ref": "#/components/schemas/Metric"
          },
          "assisted": {
            "$ref": "#/components/schemas/Metric"
          },
          "independentNew": {
            "$ref": "#/components/schemas/Metric"
          },
          "independentSeen": {
            "$ref": "#/components/schemas/Metric"
          },
          "guidedRetries": {
            "$ref": "#/components/schemas/Metric"
          },
          "corrections": {
            "$ref": "#/components/schemas/Metric"
          }
        }
      },
      "Activity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "submittedAttempts",
          "activeAttempts",
          "completedLessons",
          "learnersWithSubmissions",
          "lastSubmittedAt",
          "modes"
        ],
        "properties": {
          "submittedAttempts": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "activeAttempts": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "completedLessons": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "learnersWithSubmissions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "lastSubmittedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "modes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "submissions"
              ],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "LEARN",
                    "PRACTICE",
                    "REVIEW"
                  ]
                },
                "submissions": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "Review": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trackedObjectives",
          "needsReview",
          "mistakeObjectives",
          "pendingSubmissions",
          "nextScheduledAt"
        ],
        "properties": {
          "trackedObjectives": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "needsReview": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "mistakeObjectives": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "pendingSubmissions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "nextScheduledAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "LeagueWeek": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "week",
          "tier",
          "position",
          "xp"
        ],
        "properties": {
          "week": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "xp": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Rewards": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "totalXp",
          "level",
          "streakDays",
          "badges",
          "currentWeek",
          "history"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE"
            ]
          },
          "totalXp": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "level": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "streakDays": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "badges": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "name",
                    "earnedAt"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "earnedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "currentWeek": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LeagueWeek"
              },
              {
