{
  "openapi": "3.1.0",
  "info": {
    "title": "English Learning M07",
    "version": "1.1.0",
    "description": "Read statistics from M01–M04. Rewards optional via LearnerRewardsReader. Presence estimates open WebSocket connections; see M07_API.md for aggregation and time semantics. Teacher statistics are scoped by Unit ownership and the pinned LEARN lesson; no cross-Unit question attribution."
  },
  "paths": {
    "/api/me/statistics": {
      "get": {
        "operationId": "learnerStatistics",
        "summary": "STUDENT: learnerStatistics",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "7D",
                "30D",
                "90D"
              ],
              "default": "ALL"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Read-only database projection; private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerOverview"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED"
          },
          "401": {
            "description": "UNAUTHENTICATED / SESSION_REVOKED"
          },
          "403": {
            "description": "FORBIDDEN"
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE"
          }
        }
      }
    },
