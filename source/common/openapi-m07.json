    "/api/teacher/statistics": {
      "get": {
        "operationId": "teacherStatistics",
        "summary": "TEACHER: teacherStatistics",
        "description": "Aggregate only LEARN attempts attributed through their pinned LessonVersion to an owned Unit. No learner identities or personal answers. See M07_API.md for period and completion semantics.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "7D",
                "30D",
                "90D"
              ],
              "default": "ALL"
            }
          },
          {
            "name": "unitId",
            "in": "query",
            "description": "Optional owned Unit; foreign/missing Unit returns 404. Omit for all Units owned by the authenticated TEACHER.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Read-only database projection; private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeacherOverview"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED"
          },
          "401": {
            "description": "UNAUTHENTICATED / SESSION_REVOKED"
          },
          "403": {
            "description": "FORBIDDEN"
          },
          "404": {
            "description": "Unit does not exist or is not owned by the authenticated teacher."
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE"
          }
        }
      }
    },
