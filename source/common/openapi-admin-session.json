{
  "openapi": "3.1.0",
  "info": {
    "title": "Idle session API steps 0-2",
    "version": "1.0.0"
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/auth/session": {
      "get": {
        "operationId": "readSessionDeadline",
        "responses": {
          "200": {
            "description": "Current session deadline; reading does not renew",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store, private"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDeadline"
                }
              }
            }
          },
          "401": {
            "description": "See behavior contract ADMIN_SESSION_MONITORING_API.md",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "See behavior contract ADMIN_SESSION_MONITORING_API.md",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/activity": {
      "post": {
        "operationId": "reportSessionActivity",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Maximum 1024 UTF-8 bytes after JSON parsing",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Activity"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current session deadline; reading does not renew",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store, private"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDeadline"
                }
              }
            }
          },
          "400": {
            "description": "See behavior contract ADMIN_SESSION_MONITORING_API.md",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "See behavior contract ADMIN_SESSION_MONITORING_API.md",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "See behavior contract ADMIN_SESSION_MONITORING_API.md",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "See behavior contract ADMIN_SESSION_MONITORING_API.md",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "See behavior contract ADMIN_SESSION_MONITORING_API.md",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "See behavior contract ADMIN_SESSION_MONITORING_API.md",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "SessionDeadline": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionGeneration",
          "serverTime",
          "lastInteractionAt",
          "idleExpiresAt",
          "warningAt"
        ],
        "properties": {
          "sessionGeneration": {
            "type": "string",
            "format": "uuid"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          },
          "lastInteractionAt": {
            "type": "string",
            "format": "date-time"
          },
          "idleExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "warningAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Activity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tabId",
          "seq",
          "activity",
          "visibility",
          "interaction"
        ],
        "properties": {
          "tabId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "activity": {
            "type": "string",
            "enum": [
              "HOME",
              "LEARN",
              "REVIEW",
              "RESULT",
              "CATALOG",
              "PROFILE",
              "REWARDS",
              "LEADERBOARD",
              "AUTHORING",
              "ADMIN_USERS",
              "STATISTICS",
              "OTHER"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "VISIBLE",
              "HIDDEN"
            ]
          },
          "interaction": {
            "type": "boolean"
          },
          "attemptId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "seq": {
                  "const": 0
                }
              }
            },
            "then": {
              "properties": {
                "interaction": {
                  "const": false
                }
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
