              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "Invalid strict payload or rubric"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role denied or CSRF invalid"
          },
          "404": {
            "description": "Missing or inaccessible private resource"
