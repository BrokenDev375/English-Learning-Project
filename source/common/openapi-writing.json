    "/api/author/writing-submissions": {
      "get": {
        "operationId": "listWritingSubmissions",
        "summary": "listWritingSubmissions",
        "parameters": [
          {
            "name": "unitId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "GRADED",
                "ALL"
              ],
              "default": "PENDING"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
