  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "Criterion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,40}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "points": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "id",
          "text",
          "points"
        ]
      },
      "Definition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "minWords": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "maxWords": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "criteria": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Criterion"
            },
            "minItems": 1,
            "maxItems": 20,
            "description": "Unique stable IDs; points sum to 10."
          }
        },
        "required": [
          "title",
          "prompt",
          "minWords",
          "maxWords",
          "criteria"
        ]
      },
      "Mark": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterionId": {
            "type": "string",
            "maxLength": 40
          },
          "met": {
            "type": "boolean"
          },
          "comment": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "criterionId",
          "met",
          "comment"
        ]
      },
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "baseRevision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "requestId",
          "baseRevision"
        ]
      },
      "Start": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          }
        },
        "required": [
          "requestId"
        ]
      },
      "Version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "definition": {
            "$ref": "#/components/schemas/Definition"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "definition",
          "createdAt"
        ]
      },
      "Task": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unitId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "draft": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Definition"
              }
            ],
            "nullable": true
          },
          "published": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Version"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "unitId",
          "revision",
          "draft",
          "published"
        ]
      },
      "Work": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "versionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "SUBMITTED",
              "RETURNED",
              "GRADED"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 30000
          },
          "latestSubmissionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "versionId",
          "revision",
          "state",
          "text",
          "latestSubmissionId",
          "updatedAt"
        ]
      },
      "Grade": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "earnedPoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "totalPoints": {
            "type": "integer",
            "enum": [
              10
            ]
          },
          "marks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mark"
            }
          },
          "comment": {
            "type": "string",
            "maxLength": 4000
          },
          "allowRevision": {
            "type": "boolean"
          },
          "gradedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "earnedPoints",
          "totalPoints",
          "marks",
          "comment",
          "allowRevision",
          "gradedAt"
        ]
      },
      "Submission": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "workId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "versionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "maxLength": 30000
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "grade": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Grade"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "workId",
          "versionId",
          "text",
          "submittedAt",
          "grade"
        ]
      },
      "Learner": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unitId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "available": {
            "type": "boolean"
          },
          "unlocked": {
            "type": "boolean"
          },
          "blockReason": {
            "type": "string"
          },
          "version": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Version"
              }
            ],
            "nullable": true
          },
          "work": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Work"
              }
            ],
            "nullable": true
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Submission"
            }
          }
        },
        "required": [
          "unitId",
          "available",
          "unlocked",
          "blockReason",
          "version",
          "work",
          "history"
        ]
      },
      "QueueItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "unitId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "studentName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "graded": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "unitId",
          "studentName",
          "title",
          "submittedAt",
          "graded"
        ]
      },
      "Grading": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unitId": {
