# Local demo. scripts/init-env.ps1 creates random database and initial admin passwords.
MYSQL_DATABASE=english_learning
MYSQL_USER=english_app
MYSQL_PASSWORD=local-app-change-me
MYSQL_ROOT_PASSWORD=local-root-change-me
APP_PORT=5173
API_PORT=8080
MYSQL_PORT=3306
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@english.local
BOOTSTRAP_ADMIN_PASSWORD=generate-admin-password
DEMO_ENABLED=true
DEMO_TEACHER_EMAIL=teacher@english.local
DEMO_TEACHER_PASSWORD=Teacher@12345
DEMO_STUDENT_EMAIL=student@english.local
DEMO_STUDENT_PASSWORD=Student@12345
SESSION_COOKIE_SECURE=false
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
